{
  "$comment": "CCC Relay 三档 tier 配置模板(2026-07-25)。复制到 ~/.ccc/relay/upstreams.json 并 chmod 600。三档必填;key 收拢只在本文件。Pro 走直连绕开协议转换(高级模型档),flash/code 走 :4000/v1/messages 协议转换出口。",
  "tiers": {
    "flash": {
      "description": "轻量默认档;日常对话/多数 agent 任务;走协议转换",
      "transcode": true,
      "upstreams": [
        {
          "name": "minimax-flash",
          "base_url": "https://api.minimaxi.com/anthropic/v1",
          "upstream_model": "MiniMax-M3",
          "tier_priority": 1,
          "api_key": "sk-xxx-REPLACE-ME"
        }
      ]
    },
    "Pro": {
      "description": "高级模型档;直连绕开协议转换(拿原生 Anthropic/OpenAI 体验);不写明文 key 时降级到 flash",
      "transcode": false,
      "upstreams": [
        {
          "name": "minimax-pro",
          "base_url": "https://api.minimaxi.com/anthropic",
          "upstream_model": "claude-opus-4-8",
          "tier_priority": 1,
          "api_key": "sk-xxx-REPLACE-ME"
        }
      ]
    },
    "code": {
      "description": "写码档;OpenCode dev / 产品实现;走协议转换",
      "transcode": true,
      "upstreams": [
        {
          "name": "xfyun-code",
          "base_url": "https://maas-coding-api.cn-huabei-1.xf-yun.com/v2",
          "upstream_model": "astron-code-latest",
          "tier_priority": 1,
          "api_key": "REPLACE-ME"
        },
        {
          "name": "zhipu-code",
          "base_url": "https://open.bigmodel.cn/api/paas/v4",
          "upstream_model": "glm-4-flash",
          "tier_priority": 2,
          "api_key": "REPLACE-ME"
        }
      ]
    }
  },
  "defaults": {
    "tier": "flash"
  }
}
