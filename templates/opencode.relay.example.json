{
  "$schema": "https://opencode.ai/config.json",
  "model": "loop/flash",
  "small_model": "loop/flash",
  "provider": {
    "loop": {
      "name": "M1 ai-loop-router flash（付费-only Go）",
      "kind": "openai",
      "options": {
        "baseURL": "http://127.0.0.1:4102/v1",
        "apiKey": "sk-relay"
      },
      "models": {
        "flash": {
          "id": "flash",
          "limit": { "context": 200000, "output": 32000 },
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  }
}
