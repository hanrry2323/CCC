+def scopes_are_docs_only(scopes: list[str]) -> bool:
+    """全部 scope 落在 docs/ 或纯 markdown 报告戳记（禁止强制全仓 pytest）。"""
+    if not scopes:
+        return False
+    for s in scopes:
+        p = str(s).strip().replace("\\", "/")
+        while p.startswith("./"):
+            p = p[2:]
+        if not p:
+            return False
+        if p.startswith("docs/") or p.endswith(".md"):
+            continue
+        return False
+    return True
+
