<?xml version="1.0" encoding="UTF-8"?>
<!--
  CCC 独立中转站进程编排配置 — 模板
  部署前替换占位变量 $PROJECT_ROOT / $NODE_BIN / $LOOP_ANTHROPIC_PORT / $LOOP_OPENAI_PORT / $LOG_DIR

  安装（替换占位后复制到 LaunchAgents）:
    cp com.ccc.router.plist ~/Library/LaunchAgents/com.ccc.router.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ccc.router.plist

  卸载:
    launchctl bootout gui/$(id -u)/com.ccc.router
    rm ~/Library/LaunchAgents/com.ccc.router.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ccc.router</string>
    <key>ProgramArguments</key>
    <array>
        <string>$NODE_BIN</string>
        <string>$PROJECT_ROOT/dist/proxy.js</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LOOP_ANTHROPIC_PORT</key>
        <string>$LOOP_ANTHROPIC_PORT</string>
        <key>LOOP_OPENAI_PORT</key>
        <string>$LOOP_OPENAI_PORT</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>$PROJECT_ROOT</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$LOG_DIR/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/stderr.log</string>
</dict>
</plist>