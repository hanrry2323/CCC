<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    CCC Web Server — HTTP API + 对话面（T19 壳迁移后接管 7788）
    部署前替换以下占位变量（零字面量）：
      $PROJECT_ROOT  → CCC 仓库绝对路径
      $PYTHON_BIN    → Python 解释器绝对路径
      $LOG_DIR       → 日志目录绝对路径
      $USERNAME      → 运行用户
      $WEB_HOST      → 监听地址（生产 0.0.0.0；仅本机 127.0.0.1）
      $WEB_PORT      → 监听端口（壳迁移后 7788）
    环境变量（web/server.py 读取，零硬编码）：
      CCC_WEB_USERNAME / CCC_WEB_PASSWORD_HASH / CCC_WEB_TOKEN_TTL
      RELAY_UPSTREAM_URL / RELAY_UPSTREAM_KEY
      CCC_CONV_MODEL_NAME / CCC_CONV_UPSTREAM_PATH / CCC_CONV_UPSTREAM_TIMEOUT
  -->
  <key>Label</key>
  <string>com.ccc.web-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>$PYTHON_BIN</string>
    <string>-m</string>
    <string>server.web.server</string>
    <string>--host</string>
    <string>$WEB_HOST</string>
    <string>--port</string>
    <string>$WEB_PORT</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CCC_CONFIG_ENV</key>
    <string>$CONFIG_ENV</string>
    <key>WEB_HOST</key>
    <string>$WEB_HOST</string>
    <key>WEB_PORT</key>
    <string>$WEB_PORT</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>$PROJECT_ROOT</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>$LOG_DIR/web-server.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>$LOG_DIR/web-server.stderr.log</string>

  <key>UserName</key>
  <string>$USERNAME</string>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>ExitTimeOut</key>
  <integer>30</integer>
</dict>
</plist>
