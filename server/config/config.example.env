# ── CCC 新服务端 · 配置模板 ──
# 复制本文件为 config.env，按需填写占位值。
# 所有运行参数零硬编码；密钥只允许占位引用。

# ── 端口（engine/board/web/relay） ──
ENGINE_PORT=
BOARD_PORT=
WEB_PORT=
RELAY_PORT=

# ── 运行时解释器（消除字面工具名，部署必填） ──
PYTHON_BIN=

# ── 数据与日志路径 ──
DATA_DIR=
LOG_DIR=

# ── 模型出口上游与密钥引用 ──
RELAY_UPSTREAM_URL=
RELAY_UPSTREAM_KEY=

# ── 中转站部署路径与端口（T4 部署模板占位，部署前替换） ──
CCC_RELAY_PROJECT_ROOT=
LOOP_ANTHROPIC_PORT=
LOOP_OPENAI_PORT=
NODE_BIN=

# ── 执行体注册表路径 ──
EXECUTOR_REGISTRY_PATH=

# ── 定时任务框架（可选） ──
SCHEDULER_INTERVAL=60
# 变更类任务卡输出目录（空=禁用变更类）
SCHEDULER_DISPATCH_DIR=

# ── 集群采集目标（可选，逗号分隔 host:port） ──
CLUSTER_TARGETS=