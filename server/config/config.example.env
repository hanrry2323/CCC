# ── CCC 新服务端 · 配置模板 ──
# 复制本文件为 config.env，按需填写占位值。
# 所有运行参数零硬编码；密钥只允许占位引用。

# ── 端口（engine/board/web/relay） ──
ENGINE_PORT=
BOARD_PORT=
WEB_PORT=
RELAY_PORT=

# ── 运行时解释器（消除字面工具名，部署必填） ──
PYTHON_BIN=

# ── 数据与日志路径 ──
DATA_DIR=
LOG_DIR=

# ── 模型出口上游与密钥引用 ──
RELAY_UPSTREAM_URL=
RELAY_UPSTREAM_KEY=

# ── 对话大脑（T29：/conversation 调用 2017 Claude Code，走 6100 Anthropic 出口） ──
# Claude Code CLI 路径（默认 claude，部署机按需填绝对路径）
CCC_BRAIN_CLAUDE_BIN=claude
# 模型逻辑名（三档契约：flash / Pro / code）
CCC_BRAIN_MODEL=flash
# Claude Code 出口 base URL（如 http://127.0.0.1:6100）
CCC_BRAIN_BASE_URL=http://127.0.0.1:6100
# 出口 Bearer token（占位，部署机 config.env 实际填写）
CCC_BRAIN_AUTH_TOKEN=
# 调用超时（秒，默认 120；知识题需读文档+推理，实测 ~74s，60s 过紧）
CCC_BRAIN_TIMEOUT=120
# 跨会话总并发上限（T44；同会话串行、跨会话可并发，默认 2）
CCC_BRAIN_MAX_CONCURRENCY=2
# 模型档位列表（T44；逗号分隔，供 /config 与档位选择器，实际可用 flash/code）
CCC_MODEL_TIERS=flash,code

# ── 大脑知识库检索（T37：/conversation 回答前检索 CCC 自建知识库，命中注入 prompt） ──
# 检索开关（1/true/yes/on 启用，默认关闭；关闭时走裸大脑逻辑）
CCC_BRAIN_KB=0
# BM25 索引目录（空=默认 knowledge/.index/；与 server/kb/search.py 读取的变量同名）
CCC_KB_INDEX_DIR=
# 检索返回条数（默认 3）
CCC_BRAIN_KB_TOP_K=3

# ── 中转站部署路径与端口（T4 部署模板占位，部署前替换） ──
CCC_RELAY_PROJECT_ROOT=
LOOP_ANTHROPIC_PORT=
LOOP_OPENAI_PORT=
NODE_BIN=

# ── 执行体注册表路径 ──
EXECUTOR_REGISTRY_PATH=

# ── 执行体派发运行参数（T32 真实派发闭环） ──
# 单个执行体执行超时（秒，默认 300；超时则 kill 并按「打回」收单）
EXECUTOR_TIMEOUT_SECONDS=300
# 执行体 stdout/stderr 日志目录（每 work 一份 {work_id}.log；必填，无默认值）
EXECUTOR_LOG_DIR=/tmp/ccc-exec-logs
# 任务卡目录（P1-1 FileBoardStore 读写卡头状态；默认 docs/dispatch）
DISPATCH_DIR=docs/dispatch

# ── 定时任务框架（可选） ──
SCHEDULER_INTERVAL=60
# 变更类任务卡输出目录（空=禁用变更类）
SCHEDULER_DISPATCH_DIR=

# ── 集群采集目标（可选，逗号分隔 host:port） ──
CLUSTER_TARGETS=

# ── 集群服务清单（可选，逗号分隔 name:keyword） ──
# 进程关键词以 2017 launchd 实际命令行为准（T22 部署记录核对）。
# 三常驻服务命令行含模块名：server.web.server / server.engine.main / server.board.scheduler
CLUSTER_SERVICES=web-server:server.web.server,engine:server.engine.main,board-scheduler:server.board.scheduler

# ── Web API 鉴权（server/web/server.py；T45 免登录开关） ──
# CCC_WEB_AUTH_REQUIRED=0 → 免登录（默认；单用户局域网直连即用，全部端点免鉴权）
# CCC_WEB_AUTH_REQUIRED=1 → 启用账号密码鉴权（需配下方 CCC_WEB_USERNAME / CCC_WEB_PASSWORD_HASH）
CCC_WEB_AUTH_REQUIRED=0
# 账号（启用鉴权时必填）
CCC_WEB_USERNAME=
# 密码的 SHA-256 十六进制摘要（如 echo -n "yourpass" | shasum -a 256 | cut -d' ' -f1）
CCC_WEB_PASSWORD_HASH=
# 会话 token 有效期（秒，默认 3600）
CCC_WEB_TOKEN_TTL=3600
# 对话历史长轮询默认超时（秒，T43；GET /conversation?after=<seq> 未带 timeout 时用）
CCC_WEB_LONGPOLL_TIMEOUT=30