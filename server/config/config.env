# ── CCC 新服务端 · Mac2017 生产配置（T22 部署） ──
# 本文件由 server/config/config.example.env 复制并填值；gitignore 覆盖，不进 git。
# 零硬编码：端口/路径/账号/上游地址一律配置化；密钥零落 git。

# ── 端口（engine/board/web；engine/board 仅 cluster 元数据，不实际监听） ──
ENGINE_PORT=7789
BOARD_PORT=7788
WEB_PORT=7788

# ── 运行时解释器（部署必填） ──
PYTHON_BIN=/Users/fan/program/CCC/.venv-hub/bin/python

# ── 数据与日志路径 ──
DATA_DIR=/Users/fan/.ccc/data
LOG_DIR=/Users/fan/.ccc/logs

# ── 模型出口上游（2026-08-24 中转站退役拆除，受老板临时授权）──
# 原 RELAY_UPSTREAM_URL / RELAY_UPSTREAM_KEY（127.0.0.1:6102 ai-loop-router）已删除；
# 执行体模型出口由各自 CLI 自行直连，不再假手本机中转。

# ── 执行结果旁路观测（阶段一；空 token=关闭 POST） ──
CCC_RESULT_REPORT_TOKEN=0fc6965941c6bd946eb02178c657a7b08c98b0fa58136869
CCC_RESULT_REPORT_EVENTS_PATH=
CCC_RESULT_REPORT_URL=http://192.168.3.116:7788/api/v1/board/result

# ── 对话大脑（T29；2026-08-24 起直连 Claude CLI，不再走 6100 中转） ──
CCC_BRAIN_CLAUDE_BIN=/Users/fan/.npm-global/bin/claude
CCC_BRAIN_MODEL=flash
CCC_BRAIN_TIMEOUT=180

# ── Web API 鉴权（2026-08-24 P0-2：弱口令已轮换,新口令在 ~/.ccc/web-auth.txt；写端点强制 Bearer token） ──
CCC_WEB_USERNAME=ccc
CCC_WEB_PASSWORD_HASH=fc8b2df7c92031d8f526fd03af23f8da2f07cfe1392ec277187baac5b2e605cc
CCC_WEB_TOKEN_TTL=3600
# 写端点鉴权（P0-2 直修默认开）：免登录读保留,非 GET 变更请求需 Bearer token
CCC_WEB_WRITE_AUTH=1

# ── 执行体注册表路径 ──
EXECUTOR_REGISTRY_PATH=server/config/executors.json

# ── 定时任务框架 ──
SCHEDULER_INTERVAL=60
SCHEDULER_DISPATCH_DIR=docs/dispatch

# ── 集群采集目标（中转站 6100/6102 已退役，仅存本机看板） ──
CLUSTER_TARGETS=127.0.0.1:7788
CLUSTER_PORT_NAMES=7788:web-server

# T35 收口生产配置（M2 验证补）
EXECUTOR_LOG_DIR=/Users/fan/.ccc/logs/exec

# T35 收口生产配置（M2 验证补）
DISPATCH_DIR=docs/dispatch

# T35 收口生产配置（M2 验证补）
EXECUTOR_TIMEOUT_SECONDS=7200

# T35 收口生产配置（M2 验证补）
CLUSTER_SERVICES=web-server:server.web.server,engine:server.engine.main,board-scheduler:server.board.scheduler

# T38 M4 移交：大脑接知识库（T37）
CCC_BRAIN_KB=1
CCC_KB_INDEX_DIR=
CCC_BRAIN_KB_TOP_K=3

# 对话历史长轮询默认超时（秒，T43）
CCC_WEB_LONGPOLL_TIMEOUT=30

EXECUTOR_MAX_CONCURRENT=3
CCC_WORKTREE_BASE=/Users/fan/program/CCC-wt/<task>
CCC_AUTO_PULL=1
EXECUTOR_MAX_RETRIES=3

# 机审并发槽位（独立于执行槽，互不占位）
EXECUTOR_MAX_AUDIT_CONCURRENT=3

# 基础设施故障冷却（上游503/网络/超时；自动续审/续派，不打回）
EXECUTOR_INFRA_COOLDOWN_SECONDS=60

# 机审超时秒数（独立于执行超时，默认 30 分钟）
EXECUTOR_AUDIT_TIMEOUT_SECONDS=1800  # phase2 机审等待与此对齐

# HP 知识库节点探活（控制台）
CLUSTER_HP_TARGET=192.168.3.131:8083

CCC_BRAIN_DIRECT=1

# DSH 配额探针：真实执行通道 local-litellm（127.0.0.1:3456，经 m1-tunnel）· 模型 Code
DSH_PROBE_URL=http://127.0.0.1:3456/v1/messages
DSH_PROBE_MODEL=Code
